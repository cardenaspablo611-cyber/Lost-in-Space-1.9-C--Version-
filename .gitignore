# Unity generated (always ignore these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Vv]ersions/

# First ignore all assets
[Aa]ssets/*

# INCLUDED FOLDERS (Your work - will be on GitHub)
!Assets/Scripts/
!Assets/Scripts/**/*
!Assets/Scripts.meta
!Assets/Prefabs/
!Assets/Prefabs/**/*
!Assets/Prefabs.meta
!Assets/Scenes/
!Assets/Scenes/**/*
!Assets/Scenes.meta
!Assets/ScriptableObjects/
!Assets/ScriptableObjects/**/*
!Assets/ScriptableObjects.meta
!Assets/Materials/
!Assets/Materials/**/*
!Assets/Materials.meta
!Assets/Physics/
!Assets/Physics/**/*
!Assets/Physics.meta

# EXCLUDED FOLDERS (Third-party content - won't be on GitHub)
Assets/Audio/
Assets/Images/
Assets/Music/



# Keep these Unity files even if they're in excluded directories
!**/*.cs
!**/*.meta
!**/*.anim
!**/*.controller
!**/*.prefab
!**/*.physicMaterial
!**/*.asset
!**/*.unity

# Specific file types to ignore (regardless of location)
*.psd
*.ai
*.sketch
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.gif
*.mp3
*.wav
*.ogg
*.aif
*.aiff
*.fbx
*.obj
*.mtl
*.3ds
*.max
*.blend
*.dae
*.ma
*.mb
*.ttf
*.otf
*.woff
*.woff2

# Visual Studio / VS Code
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Exception: Keep specific project files
!README.md
!.gitignore
!ProjectSettings/
!ProjectSettings/**/*
!Packages/manifest.json
!Packages/packages-lock.json 